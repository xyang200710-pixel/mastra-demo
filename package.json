{
  "name": "mastra-qa-demo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names mastra,ui \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "mastra dev --dir src/mastra --env .env",
    "dev:ui": "vite --config client/vite.config.ts",
    "build": "mastra build",
    "start": "mastra start",
    "qa": "node --env-file=.env --import tsx/esm src/qa.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^2.0.106",
    "@mastra/client-js": "^1.23.2",
    "@mastra/core": "latest",
    "@mastra/libsql": "^1.12.1",
    "@mastra/memory": "^1.20.2",
    "ai": "^5.0.196",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonrepair": "^3.14.0",
    "mastra": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
